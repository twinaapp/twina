<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Twina"
        Arguments=""
        InstallLocation="C:\Program Files\Twina">
    </Installer>
    <PackageInformation
        PackageName="Twina"
        PackageDisplayName="Twina"
        PublisherName="CN=Twina"
        PublisherDisplayName="Twina"
        Version="0.0.0.0"
        PackageDescription="A dual-panel file manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.twina"
                Description="A dual-panel file manager"
                DisplayName="Twina"
                ExecutableName="Twina"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Twina</DisplayName>
            <PublisherDisplayName>Twina</PublisherDisplayName>
            <Description>A dual-panel file manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="Twina.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
